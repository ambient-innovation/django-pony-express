#: .\services\base.py:45
msgid "Email factory requires a mail service class."
msgstr "E-Mailfactory benötigt eine Mailservice-Klasse."

#: .\services\base.py:47
msgid "Email factory requires a target mail address."
msgstr "E-Mailfactory benötigt eine Ziel-Mailadresse."

#: .\services\base.py:241
msgid "Missing or mislabeled data provided for email attachment."
msgstr "Fehlende oder falsch deklarierte Daten für E-Mailanhänge übergeben."

#: .\services\base.py:318
msgid "Email service requires a subject."
msgstr "E-Mailservice benötigt einen Betreff."

#: .\services\base.py:320
msgid "Email service requires a template."
msgstr "E-Mailservice benötigt ein Template."

#: .\services\base.py:322
msgid "Email service requires a target mail address."
msgstr "E-Mailservice benötigt eine Ziel-Mailadresse."

#: .\services\base.py:326
#, python-brace-format
msgid "Email service received ill-formatted email address \"{email}\""
msgstr ""
"E-Mailservice hat die ungültig formatierte E-Mailadresse \"{email}\" "
"erhalten."

#: .\services\base.py:362
#, python-format
msgid "Email \"%s\" successfully sent to %s."
msgstr "E-Mail \"%s\" erfolgreich versendet an %s."

#: .\services\base.py:364
#, python-format
msgid "Email \"%s\" successfully sent."
msgstr "E-Mail \"%s\" erfolgreich versendet."

#: .\services\base.py:366
#, python-format
msgid "Email \"%s\" was not sent to %s."
msgstr "E-Mail \"%s\" wurde nicht an %s versendet."

#: .\services\base.py:368
#, python-format
msgid "Email \"%s\" was not sent."
msgstr "E-Mail \"%s\" wurde nicht versendet."

#: .\services\base.py:384
#, python-format
msgid "An error occurred sending email \"%s\" to \"%s\"."
msgstr "Beim Versenden der E-Mail \"%s\" an \"%s\" ist ein Fehler aufgetreten."

#: .\services\base.py:387
#, python-format
msgid "An error occurred sending email \"%s\"."
msgstr "Beim Versenden der E-Mail \"%s\" ist ein Fehler aufgetreten."
